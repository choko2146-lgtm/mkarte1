<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/mkarte_accent_pale" />
            <stroke
                android:width="1dp"
                android:color="@color/mkarte_accent_soft" />
            <corners android:radius="@dimen/radius_large" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/mkarte_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/mkarte_border" />
            <corners android:radius="@dimen/radius_large" />
        </shape>
    </item>
</selector>
