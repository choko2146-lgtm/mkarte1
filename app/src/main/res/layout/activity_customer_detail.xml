<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mkarte_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="@dimen/mkarte_screen_padding">

        <TextView
            android:id="@+id/buttonBackCustomerDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:text="←  顧客詳細"
            android:textColor="@color/mkarte_text"
            android:textSize="@dimen/text_screen_title"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/bg_card"
            android:elevation="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/mkarte_card_padding">

            <TextView
                android:id="@+id/textCustomerInitial"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_customer_avatar"
                android:gravity="center"
                android:textColor="@color/mkarte_avatar_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textCustomerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/mkarte_text"
                android:textSize="@dimen/text_section_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textCustomerKana"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/mkarte_text_subtle"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <Button
                android:id="@+id/buttonEditCustomer"
                android:layout_width="92dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_button_light"
                android:drawableStart="@drawable/ic_edit_24"
                android:drawablePadding="4dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="編集"
                android:textColor="@color/mkarte_text"
                android:textSize="@dimen/text_body" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/bg_card"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="@dimen/mkarte_card_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="基本情報"
                android:textColor="@color/mkarte_text"
                android:textSize="@dimen/text_card_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textCustomer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:lineSpacingExtra="6dp"
                android:textColor="@color/mkarte_text"
                android:textSize="@dimen/text_body" />

            <Button
                android:id="@+id/buttonDeleteCustomer"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_button_danger"
                android:text="顧客を削除"
                android:textColor="@color/mkarte_danger"
                android:textSize="@dimen/text_body" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_md"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="@dimen/mkarte_card_padding">

            <TextView
                android:id="@+id/textVisitSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="撮影履歴・写真"
                android:textColor="@color/mkarte_text"
                android:textSize="@dimen/text_card_title"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerPhotos"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/space_sm"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="4dp" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/layout_bottom_nav" />
</LinearLayout>
