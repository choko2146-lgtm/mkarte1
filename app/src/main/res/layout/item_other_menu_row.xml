<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_md"
    android:paddingEnd="@dimen/space_md">

    <ImageView
        android:id="@+id/imageOtherIcon"
        android:layout_width="@dimen/icon_bottom_nav"
        android:layout_height="@dimen/icon_bottom_nav"
        android:contentDescription="項目" />

    <TextView
        android:id="@+id/textOtherTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_weight="1"
        android:textColor="@color/mkarte_text"
        android:textSize="@dimen/text_body"
        android:textStyle="bold" />

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="開く"
        android:src="@drawable/ic_chevron_right_24" />
</LinearLayout>
