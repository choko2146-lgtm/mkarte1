<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mkarte_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/mkarte_screen_padding"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/mkarte_screen_padding"
        android:paddingBottom="@dimen/space_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="@dimen/space_xs"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/buttonBackPhoto"
            android:layout_width="72dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_button_back"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="←"
            android:textColor="@color/mkarte_text"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/textPhotoCounter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/mkarte_text"
            android:textSize="@dimen/text_card_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="44dp"
            android:layout_height="44dp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.75"
        android:layout_marginTop="@dimen/space_sm"
        android:background="@drawable/bg_card"
        android:elevation="1dp"
        android:padding="6dp">

        <ImageView
            android:id="@+id/imagePhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_photo_placeholder"
            android:contentDescription="写真"
            android:scaleType="fitCenter" />

        <Button
            android:id="@+id/buttonPreviousPhoto"
            android:layout_width="44dp"
            android:layout_height="54dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_photo_nav"
            android:text="‹"
            android:textColor="@color/mkarte_text"
            android:textSize="30sp" />

        <Button
            android:id="@+id/buttonNextPhoto"
            android:layout_width="44dp"
            android:layout_height="54dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="@dimen/space_sm"
            android:background="@drawable/bg_photo_nav"
            android:text="›"
            android:textColor="@color/mkarte_text"
            android:textSize="30sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:background="@drawable/bg_card"
        android:elevation="1dp"
        android:orientation="vertical"
        android:padding="@dimen/mkarte_card_padding">

        <TextView
            android:id="@+id/textPhoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lineSpacingExtra="3dp"
            android:maxLines="2"
            android:textColor="@color/mkarte_text"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/editMemo"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:gravity="top"
                android:hint="メモ"
                android:inputType="textMultiLine"
                android:padding="12dp"
                android:textColor="@color/mkarte_text"
                android:textColorHint="@color/mkarte_text_subtle"
                android:textSize="@dimen/text_body" />

            <Button
                android:id="@+id/buttonSaveMemo"
                android:layout_width="104dp"
                android:layout_height="44dp"
                android:layout_marginStart="@dimen/space_sm"
                android:background="@drawable/bg_button_edit"
                android:drawableStart="@drawable/ic_edit_24"
                android:drawablePadding="4dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="メモ追加"
                android:textColor="@color/mkarte_text"
                android:textSize="@dimen/text_body" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonPreviewPhoto"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_light"
                android:drawableStart="@drawable/ic_preview_24"
                android:drawablePadding="6dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="拡大表示"
                android:textColor="@color/mkarte_text"
                android:textSize="@dimen/text_body" />

            <Button
                android:id="@+id/buttonDeletePhoto"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:background="@drawable/bg_button_danger"
                android:drawableStart="@drawable/ic_delete_24"
                android:drawablePadding="6dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="削除"
                android:textColor="@color/mkarte_danger_text"
                android:textSize="@dimen/text_body" />
        </LinearLayout>
    </LinearLayout>

    </LinearLayout>

    <include layout="@layout/layout_bottom_nav" />
</LinearLayout>
