<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mkarte_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/mkarte_screen_padding">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="顧客情報"
            android:textColor="@color/mkarte_text"
            android:textSize="@dimen/mkarte_title_text"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="@dimen/mkarte_card_padding">

            <EditText
                android:id="@+id/editName"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/bg_input"
                android:hint="顧客名（必須）"
                android:inputType="textPersonName"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/mkarte_text"
                android:textColorHint="@color/mkarte_text_subtle"
                android:textSize="@dimen/mkarte_body_text" />

            <EditText
                android:id="@+id/editKana"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="@dimen/mkarte_item_gap"
                android:background="@drawable/bg_input"
                android:hint="フリガナ"
                android:inputType="text"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/mkarte_text"
                android:textColorHint="@color/mkarte_text_subtle"
                android:textSize="@dimen/mkarte_body_text" />

            <EditText
                android:id="@+id/editPhone"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="@dimen/mkarte_item_gap"
                android:background="@drawable/bg_input"
                android:hint="電話番号"
                android:inputType="phone"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/mkarte_text"
                android:textColorHint="@color/mkarte_text_subtle"
                android:textSize="@dimen/mkarte_body_text" />

            <EditText
                android:id="@+id/editPostalCode"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="@dimen/mkarte_item_gap"
                android:background="@drawable/bg_input"
                android:hint="郵便番号"
                android:inputType="textPostalAddress"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/mkarte_text"
                android:textColorHint="@color/mkarte_text_subtle"
                android:textSize="@dimen/mkarte_body_text" />

            <EditText
                android:id="@+id/editAddress"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="@dimen/mkarte_item_gap"
                android:background="@drawable/bg_input"
                android:hint="住所"
                android:inputType="textPostalAddress"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/mkarte_text"
                android:textColorHint="@color/mkarte_text_subtle"
                android:textSize="@dimen/mkarte_body_text" />

            <EditText
                android:id="@+id/editMemo"
                android:layout_width="match_parent"
                android:layout_height="132dp"
                android:layout_marginTop="@dimen/mkarte_item_gap"
                android:background="@drawable/bg_input"
                android:gravity="top"
                android:hint="メモ"
                android:inputType="textMultiLine"
                android:padding="14dp"
                android:textColor="@color/mkarte_text"
                android:textColorHint="@color/mkarte_text_subtle"
                android:textSize="@dimen/mkarte_body_text" />
        </LinearLayout>

        <Button
            android:id="@+id/buttonSave"
            android:layout_width="match_parent"
            android:layout_height="@dimen/mkarte_button_height"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_primary"
            android:drawableStart="@drawable/ic_save_24"
            android:drawablePadding="8dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="保存する"
            android:textColor="@color/mkarte_text"
            android:textSize="17sp" />

        <Button
            android:id="@+id/buttonBack"
            android:layout_width="match_parent"
            android:layout_height="@dimen/mkarte_button_height"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_secondary"
            android:text="戻る"
            android:textColor="@color/mkarte_text"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
