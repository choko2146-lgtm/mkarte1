<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mkarte_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/mkarte_screen_padding"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/mkarte_screen_padding"
        android:paddingBottom="@dimen/space_sm">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="おかんのカルテA"
                android:textColor="@color/mkarte_text"
                android:textSize="@dimen/text_screen_title"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_feature_card"
                android:elevation="1dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:lineSpacingExtra="2dp"
                    android:text="こんにちは！\n今日も素敵な一日になりますように。"
                    android:textColor="@color/mkarte_text"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:alpha="0.3"
                    android:contentDescription="装飾"
                    android:src="@drawable/ic_content_cut_64" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/buttonCamera"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_hero_action_card"
                android:clickable="true"
                android:elevation="2dp"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="14dp">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_icon_pink">

                    <ImageView
                        android:layout_width="@dimen/icon_hero"
                        android:layout_height="@dimen/icon_hero"
                        android:layout_gravity="center"
                        android:contentDescription="写真を撮る"
                        android:src="@drawable/ic_camera_24" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="写真を撮る"
                    android:textColor="@color/mkarte_text"
                    android:textSize="@dimen/text_section_title"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="撮影へ"
                    android:src="@drawable/ic_chevron_right_24" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="最近撮影したお客様"
                    android:textColor="@color/mkarte_text"
                    android:textSize="@dimen/text_card_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/buttonAllCustomers"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="すべて見る 〉"
                    android:textColor="@color/mkarte_text_subtle"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/recentCustomersContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/recentCustomerRow1"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginBottom="@dimen/space_sm"
                    android:background="@drawable/bg_feature_card"
                    android:clickable="true"
                    android:elevation="0dp"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:id="@+id/recentInitial1"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_customer_avatar"
                        android:gravity="center"
                        android:textColor="@color/mkarte_avatar_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/recentName1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/mkarte_text"
                            android:textSize="@dimen/text_body"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/recentDate1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/mkarte_text_subtle"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="詳細へ"
                        android:src="@drawable/ic_chevron_right_24" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/recentCustomerRow2"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginBottom="@dimen/space_sm"
                    android:background="@drawable/bg_feature_card"
                    android:clickable="true"
                    android:elevation="0dp"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:id="@+id/recentInitial2"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_customer_avatar"
                        android:gravity="center"
                        android:textColor="@color/mkarte_avatar_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/recentName2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/mkarte_text"
                            android:textSize="@dimen/text_body"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/recentDate2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/mkarte_text_subtle"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="詳細へ"
                        android:src="@drawable/ic_chevron_right_24" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/recentCustomerRow3"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_feature_card"
                    android:clickable="true"
                    android:elevation="0dp"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:id="@+id/recentInitial3"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_customer_avatar"
                        android:gravity="center"
                        android:textColor="@color/mkarte_avatar_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/recentName3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/mkarte_text"
                            android:textSize="@dimen/text_body"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/recentDate3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/mkarte_text_subtle"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="詳細へ"
                        android:src="@drawable/ic_chevron_right_24" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/recentEmptyText"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_feature_card"
                android:gravity="center"
                android:text="最近撮影したお客様はまだありません"
                android:textColor="@color/mkarte_text_subtle"
                android:textSize="@dimen/text_body"
                android:visibility="gone" />

            <TextView
                android:id="@+id/buttonCustomerRegister"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_button_light"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="新規顧客登録"
                android:textColor="@color/mkarte_text"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />
    </LinearLayout>

    <include layout="@layout/layout_bottom_nav" />
</LinearLayout>
